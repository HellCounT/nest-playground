NODE_ENV=development
###############################################################################
#INFRASTRUCTURE CONFIGURATION + SECRETS + SENSITIVE APPLICATION/DOMAIN SETTINGS

#APPLICATION CONFIGURATION
APP_URL=https://127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_playground

#AUTH CONFIGURATION
ROUND_SALT_FOR_HASHPASSWORD=10
EXPIRATION_ACCESS_TOKEN=10m
SECRET_ACCESS_TOKEN=atoken
EXPIRATION_REFRESH_TOKEN=500m
SECRET_REFRESH_TOKEN=rtoken

#OPTIONS
IS_SWAGGER_ENABLED=true
INCLUDE_TESTING_MODULE=true
INCLUDE_OBSERVE_MODULE=false
OBSERVE_APP_KEY=observeappkey
OBSERVE_APP_SECRET=obsereappsecret

#STORAGE CONFIGURATION
STORAGE_URL=http://127.0.0.1:9000
STORAGE_REGION=ru-central1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET_NAME=nest-playground-bucket

###############################################################################
#APPLICATION/DOMAIN SETTINGS

#DOMAIN CONFIGURATION

FILE_NAME=.env.development